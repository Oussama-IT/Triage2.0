        <script><![CDATA[/**
 * UI Action: Retirer
 * Removes the user from the group, then deletes the link record.
 */
(function executeAction(current) {

    var gm = new GlideRecord('sys_user_grmember');
    gm.addQuery('user',  current.user);
    gm.addQuery('group', current.group);
    gm.query();
    while (gm.next()) {
        gm.deleteRecord();   // remove membership
    }

    current.deleteRecord();  // remove the link itself
    action.setRedirectURL(current.getTableName() + '_list.do');

})(current);
]]></script>
