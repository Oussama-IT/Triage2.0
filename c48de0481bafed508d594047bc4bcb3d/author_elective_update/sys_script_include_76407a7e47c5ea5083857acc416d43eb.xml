        <description/>
        <mobile_callable>false</mobile_callable>
        <name>getOrthosPerRole</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var getOrthosPerRole = Class.create();
getOrthosPerRole.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {
    /**
     * Return a JSON-encoded array of all users who hold
     * the Orthophoniste role (even though sys_user.role is empty).
     * Example: '[{"sys_id":"46f5d0b1c0a80164007de9b35498eede","name":"John Doe"}]'
     */
    getOrthosPerRole: function() {

        var roleName = 'x_ndecd_triage_2_0.Orthophoniste';
        var roleGR = new GlideRecord('sys_user_role');
        roleGR.addQuery('name', roleName).query();

        if (!roleGR.next()) {return '[]';}

        var list = [];
        var usrRole = new GlideRecord('sys_user_has_role');
        usrRole.addQuery('role', roleGR.getUniqueValue()).query();

        while (usrRole.next()) {
            var u = usrRole.user.getRefRecord(); 
            list.push({
                sys_id: u.getUniqueValue(),
                name: u.getDisplayValue()
            });
        }
        return JSON.stringify(list);
    },
    isPublic: true,

    type: 'getOrthosPerRole'
});]]></script>
