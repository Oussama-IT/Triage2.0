        <script><![CDATA[var CheckIfStudentHasOpenTSARequests = Class.create();
CheckIfStudentHasOpenTSARequests.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {

    checkStudent: function() {
        var sysId = this.getParameter('sysparm_sysId');

        var gr = new GlideRecord('x_ndecd_triage_2_0_demande_tsa');
        gr.addQuery('eleve', sysId);
        gr.addQuery('state', 1);
        gr.query();

        if (gr.next()) {
            return 'true';
        }

        return 'false';
    },

    type: 'CheckIfStudentHasOpenTSARequests'
});]]></script>
