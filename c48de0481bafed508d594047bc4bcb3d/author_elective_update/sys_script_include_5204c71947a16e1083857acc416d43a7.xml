        <name>GetStudentsFromSchool</name>
        <sandbox_callable>true</sandbox_callable>
        <script><![CDATA[    function GetStudentsFromSchool() {
		gs.info("here 123");

		
        var userId = gs.getUserID();
        var userGR = new GlideRecord('sys_user');
        userGR.get(userId);
        
        var school = new GlideRecord('x_ndecd_triage_2_0_x_ndecd_school');
        school.addEncodedQuery('adminsCONTAINS' + userId);
        school.setLimit(1);
        school.query();

        if (school.next()) {
            gs.info("here 123456 " + school.sys_id.toString());
            var studentsList = [];
            var students = new GlideRecord('x_ndecd_triage_2_0_eleve');
            students.addQuery('u_nom_de_l_cole', school.sys_id.toString());
            students.query();
            while (students.next()) {
                gs.info('testtesttest ' + students);
                studentsList.push(students.sys_id.toString());
            }
            return studentsList.join(',');
        }

        return '';
    }]]></script>
