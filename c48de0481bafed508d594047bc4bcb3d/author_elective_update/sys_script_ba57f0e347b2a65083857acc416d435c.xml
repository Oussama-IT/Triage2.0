        <script><![CDATA[(function executeRule(current, previous) {

    gs.info('[SyncMembers] BR fired on record: ' + current.sys_id);

    var grpId = String(current.group);
    if (!grpId) {
        gs.info('[SyncMembers] Record has no group – exiting.');
        return;
    }
    gs.info('[SyncMembers] Target group: ' + grpId);

    function toList(s) { return s ? s.split(',').filter(Boolean) : []; }

    var newList = toList(String(current.membres));
    var oldList = previous ? toList(String(previous.membres)) : [];

    gs.info('[SyncMembers] New list (' + newList.length + '): ' + newList.join(','));
    gs.info('[SyncMembers] Old list (' + oldList.length + '): ' + oldList.join(','));

    var seen = {};
    oldList.forEach(function (id) { seen[id] = true; });

    var added = 0, removed = 0;

    // Adds
    newList.forEach(function (id) {
        if (!seen[id]) {
            var gm = new GlideRecord('sys_user_grmember');
            gm.addQuery('user', id);
            gm.addQuery('group', grpId);
            gm.query();
            if (!gm.hasNext()) {
                gm.initialize();
                gm.user  = id;
                gm.group = grpId;
                gm.insert();
                added++;
                gs.info('[SyncMembers] Added user ' + id + ' to group ' + grpId);
            } else {
                gs.info('[SyncMembers] User ' + id + ' already a member – skipped add');
            }
        }
        delete seen[id]; // matched; remove from deletion list
    });

    // Removals
    for (var id in seen) {
        var gmDel = new GlideRecord('sys_user_grmember');
        gmDel.addQuery('user', id);
        gmDel.addQuery('group', grpId);
        gmDel.query();
        while (gmDel.next()) {
            gmDel.deleteRecord();
            removed++;
            gs.info('[SyncMembers] Removed user ' + id + ' from group ' + grpId);
        }
    }

    gs.info('[SyncMembers] Completed: ' + added + ' added, ' + removed + ' removed.');

})(current, previous);
]]></script>
