        <script><![CDATA[(function executeRule(current, previous) {

    var grpId = String(current.group);
    if (!grpId) return;

    function toList(s) { return s ? s.split(',').filter(Boolean) : []; }

    var newList = toList(String(current.membres));
    var oldList = previous ? toList(String(previous.membres)) : [];

    var seen = {};
    oldList.forEach(function (id) { seen[id] = true; });

    // Adds
    newList.forEach(function (id) {
        if (!seen[id]) {
            var gm = new GlideRecord('sys_user_grmember');
            gm.addQuery('user', id);
            gm.addQuery('group', grpId);
            gm.query();                                
            if (!gm.hasNext()) {
                gm.initialize();
                gm.user  = id;
                gm.group = grpId;
                gm.insert();
            }
        }
        delete seen[id];
    });

    // Removals
    for (var id in seen) {
        var gmDel = new GlideRecord('sys_user_grmember');
        gmDel.addQuery('user', id);
        gmDel.addQuery('group', grpId);
        gmDel.query();
        while (gmDel.next()) gmDel.deleteRecord();
    }

})(current, previous);]]></script>
