        <api_name>x_ndecd_triage_2_0.getStudentsFromSameSchool</api_name>
        <caller_access/>
        <client_callable>true</client_callable>
        <description/>
        <mobile_callable>false</mobile_callable>
        <name>getStudentsFromSameSchool</name>
        <sandbox_callable>true</sandbox_callable>
        <script><![CDATA[function getStudentsFromSameSchool() {
    var userId = gs.getUserID();

    var school = new GlideRecord('x_ndecd_triage_2_0_x_ndecd_school');
    school.addEncodedQuery('adminsCONTAINS' + userId);
    school.setLimit(1);
    school.query();

    if (school.next()) {
        var studentsList = [];
        var students = new GlideRecord('x_ndecd_triage_2_0_eleve');
        students.addQuery('u_nom_de_l_cole', school.sys_id.toString());
        students.query();
        while (students.next()) {
            studentsList.push(students.sys_id.toString());
        }
        return studentsList;
    }

    return '';
}]]></script>
