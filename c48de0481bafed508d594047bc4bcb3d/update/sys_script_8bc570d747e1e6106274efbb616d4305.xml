        <script><![CDATA[(function executeRule(current /*, previous*/ ) {
    var noteGR = new GlideRecord('sys_journal_field');
    noteGR.addQuery('element_id', current.sys_id);
    noteGR.orderByDesc('sys_created_on');
    noteGR.setLimit(1);
    noteGR.query();

    if (!noteGR.next()) {
        return;
    }

    var noteText = (noteGR.value + '').toLowerCase();
    var noteAuthorName = noteGR.sys_created_by + '';

    if (!noteText.includes('consentement parental obtenu')) {
        return;
    }

    if (current.opened_by &&
        current.opened_by.email.toString() === noteAuthorName) {
        current.le_formulaire_de_consentement_sign_a_t_il_t_plac_en_pi_ce_jointe = 'oui';
        current.update();
        return;
    }

    var roleGR = new GlideRecord('sys_user_has_role');
    roleGR.addEncodedQuery('user.user_name=' + noteAuthorName +
        '^role.name=x_ndecd_triage_2_0.Direction');
    roleGR.setLimit(1);
    roleGR.query();

    if (roleGR.hasNext()) {
        current.le_formulaire_de_consentement_sign_a_t_il_t_plac_en_pi_ce_jointe = 'oui';
        current.update();
    }
})(current);]]></script>
